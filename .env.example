# ── Frontend (this Next.js app) ─────────────────────────────────────────────
# API base including /api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public origin used to open uploaded files (docs, receipts) in the browser.
# Same idea as backend APP_BASE_URL — use your production domain in deploy.
# Example: https://api.yourdomain.com
NEXT_PUBLIC_APP_BASE_URL=http://localhost:8000

# ── Backend (set on the API server, not this frontend) ──────────────────────
# Used when generating absolute URLs inside leads_export.xlsx
# APP_BASE_URL=https://api.yourdomain.com
